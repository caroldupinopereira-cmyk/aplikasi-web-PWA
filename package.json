{
  "name": "sistema-administrasaun-postu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build": "bash scripts/build-verified.sh",
    "test": "npm run build && node --experimental-strip-types --test --test-isolation=none tests/dashboard-access.test.mjs tests/dashboard-calculations.test.mjs tests/data-quality.test.mjs tests/document-number.test.mjs tests/password-security.test.mjs tests/role-permissions.test.mjs tests/session-security.test.mjs tests/rendered-html.test.mjs",
    "test:dashboard": "node --experimental-strip-types --test --test-isolation=none tests/dashboard-access.test.mjs tests/dashboard-calculations.test.mjs",
    "test:auth": "node --experimental-strip-types --test --test-isolation=none tests/password-security.test.mjs tests/session-security.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local --config wrangler.local.jsonc",
    "backup:local": "powershell -ExecutionPolicy Bypass -File scripts/backup-local.ps1"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Sistema Administrasaun Postu"
}
